; FaceGate 串口协议配置示例（拷贝到 exe 同目录 gate.ini 后按需修改）
; 全部键可省略：缺省即下方值（常见 CH340 类 USB 继电器板出厂协议）
; 任何键非法（非十六进制 / >0xFF / baud<=0）→ 整体回退缺省并打印红字日志
;
; 帧格式（5 字节）：[帧头, 板地址, 命令, 通道, 校验和]
;   校验和 = 前 4 字节之和的低 8 位
;   开帧：A0 01 01 01 A3    关帧：A0 01 00 01 A2
;
; 串口链路参数固定：8 数据位 / 无校验 / 1 停止位 / 无流控（不进配置）

[Serial]
head=A0      ; 帧头（十六进制）
addr=01      ; 板卡地址（十六进制）
cmd_on=01    ; 开命令（十六进制）
cmd_off=00   ; 关命令（十六进制）
channel=01   ; 继电器通道，接闸机开门线（十六进制）
baud=9600    ; 波特率（十进制）
